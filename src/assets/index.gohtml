<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#167b54" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SignTools" />
    <meta name="referrer" content="same-origin" />
    <title>SignTools · Your app library</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/pwa/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/vendor/app.css" />
  </head>
  <body>
    <div id="app"></div>
    <noscript>
      <main class="standalone">
        <div class="standalone-card">
          <h1>SignTools</h1>
          <p>Enable JavaScript to manage your app library, builders, profiles, and sources.</p>
          {{block "apps" .}} {{range .Apps}}
          <article data-id="{{.Id}}">
            <h2>{{.Name}}</h2>
            <p>{{.Version}} · {{.ProfileName}}</p>
            {{if and (eq .Status 1) (not .IsMac)}}<a href="{{.InstallUrl}}">Install</a>{{end}}
          </article>
          {{end}} {{end}} {{block "tweaks" .}} {{range .Tweaks}}
          <article data-id="{{.Id}}"><a href="{{.DownloadUrl}}">{{.Name}}</a></article>
          {{end}} {{end}} {{block "savedTweaks" .}} {{range .Tweaks}}
          <label><input type="checkbox" name="saved_tweak_ids" value="{{.Id}}" />{{.Name}}</label>
          {{end}} {{end}}
        </div>
      </main>
    </noscript>
    <script type="module" src="/js/index.js"></script>
  </body>
</html>
