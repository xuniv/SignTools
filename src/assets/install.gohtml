<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#167b54" />
    <title>SignTools · Install {{.AppName}}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/vendor/app.css" />
  </head>
  <body>
    <main class="standalone">
      <div class="standalone-card">
        <a class="brand" href="/" target="_top"><img src="/favicon.png" alt="" />SignTools</a>
        <div
          class="mt-8 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
        >
          <svg
            width="26"
            height="26"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="m5 12 4 4L19 6" />
            <path d="M20 13v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9" />
          </svg>
        </div>
        <h1>{{.AppName}}</h1>
        {{if .InstallOnly}}
        <p class="mt-3 text-xs">Original IPA · Signature preserved</p>
        {{end}} {{range .Limitations}}
        <p
          class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200"
        >
          {{.}}
        </p>
        {{end}}
        <p>Your signed app is ready. Tap below, then confirm the installation on your device.</p>
        <a
          id="install-link"
          class="primary-link"
          href="itms-services://?action=download-manifest&amp;url={{.ManifestUrl}}"
          target="_top"
          >Install on this device</a
        >
        <p id="install-feedback" class="mt-4 text-xs" hidden>
          Check your Home Screen for installation progress. You can safely close this page.
        </p>
        <p class="mt-4 text-xs">
          iPhone or iPad required. If installation does not start, open this page in Safari and try again.
        </p>
        <a class="back-link" href="/" target="_top">Back to your library</a>
      </div>
    </main>
    <script type="module" src="/js/install.js"></script>
  </body>
</html>
