<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>SignTools · Rename {{.Kind}}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/vendor/app.css" />
  </head>
  <body>
    <main class="standalone">
      <div class="standalone-card">
        <a class="brand" href="/" target="_top"><img src="/favicon.png" alt="" />SignTools</a>
        <h1>Rename {{.Kind}}</h1>
        <p>A familiar name makes everything easier to find.</p>
        <form id="rename-form" method="post" enctype="multipart/form-data">
          <label for="formName">{{.Kind}} name</label>
          <input id="formName" name="name" type="text" value="{{.Name}}" required autofocus />
          {{if .Hint}}
          <p class="text-xs">{{.Hint}}</p>
          {{end}}
          <button class="primary-link" type="submit">Save name</button>
          <p id="form-feedback" role="status" hidden></p>
        </form>
        <a class="back-link" href="{{.BackUrl}}" target="_top">Back to your library</a>
      </div>
    </main>
    <script type="module" src="/js/rename.js"></script>
  </body>
</html>
