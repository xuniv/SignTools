{
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "bun scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "bun test src/web",
    "fmt": "prettier --write src/web scripts package.json tsconfig.json components.json src/assets/*.gohtml src/assets/2fa.html",
    "fmt:check": "prettier --check src/web scripts package.json tsconfig.json components.json src/assets/*.gohtml src/assets/2fa.html"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@uppy/core": "6.3.1",
    "@uppy/tus": "6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "git-format-staged": "^4.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.gohtml",
        "options": {
          "parser": "html"
        }
      }
    ],
    "printWidth": 119
  }
}
